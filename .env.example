# Never commit a real API key. Add secrets in your deployment host instead.
# OpenRouter powers script drafts only. Select an available :free model in OpenRouter's model catalogue,
# or leave OPENROUTER_MODEL empty and the server will select an available free text model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
APP_URL=https://studio.saulspodship.com

# Free Pexels stock-video search. Create a key at https://www.pexels.com/api/
# It is used only by the server-side /api/search-broll endpoint.
PEXELS_API_KEY=

# Optional. A secure, server-side job orchestrator that makes the final video.
# AI_SCRIPT_WEBHOOK=
# AI_RENDER_WEBHOOK=
